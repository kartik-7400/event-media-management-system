# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Use local MongoDB for development fallback or MongoDB Atlas URI
MONGODB_URI=mongodb://127.0.0.1:27017/event-media-hub

# Authentication
# Secret key used to sign and verify JSON Web Tokens (JWT)
JWT_SECRET=your_jwt_secret_key_here

# AWS Cloud Integration Config
# Set AWS_MOCK=true to run in offline mock mode, or leave credential fields empty to auto-fallback.
AWS_MOCK=false
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1

# AWS S3 Storage Config
AWS_S3_BUCKET_NAME=your-s3-bucket-name-here

# AWS Rekognition Config
AWS_REKOGNITION_COLLECTION_ID=event-media-hub-faces-here
